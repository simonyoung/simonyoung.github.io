---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

// Get 3 most recent posts
// @ts-ignore - types are generated after content collections are discovered
const recent = (await (getCollection as any)('blog'))
  .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout title="Simon Young | Software Engineering Leader">
  <div class="slate-container py-12">
    <section class="mb-16">
      <div class="prose dark:prose-invert lg:prose-lg">
        <p class="text-xl leading-relaxed">I'm Simon, an experienced software engineering leader currently working at <a href="https://lego.com/" class="slate-link">The LEGO Group</a>.</p>
        
        <ul class="mt-6 space-y-2">
          <li>More than 25 years of experience in all aspects of software engineering and architecture</li>
          <li>Vice President for Shopper Technology at the LEGO Group, leading a 100+ person software engineering team</li>
        </ul>
        
        <p class="mt-6">Find me on <a href="https://www.linkedin.com/in/simonyounguk/" class="slate-link">LinkedIn</a> 🤘</p>
      </div>
    </section>
    
    <section aria-labelledby="articles-heading" class="mb-8">
      <h2 id="articles-heading" class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">Recent Articles</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recent.map((post: any) => (
          <a href={`/blog/${post.slug}/`} class="group rounded-xl border border-gray-200 dark:border-gray-800 p-5 hover:shadow-md transition-shadow">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400">{post.data.title}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
              {new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            {post.data.description && <p class="mt-2 text-gray-600 dark:text-gray-300 line-clamp-2">{post.data.description}</p>}
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/blog" class="slate-link inline-flex items-center">
          View all articles
          <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
