---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// @ts-ignore - types are generated after content collections are discovered
const posts = (await (getCollection as any)('blog'))
interface BlogPost {
  slug: string;
  data: {
    title: string;
    date: Date;
   author?: string;
   description?: string;
 };
}

const posts = (await getCollection('blog') as BlogPost[])
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Blog | Simon Young" description="Articles and thoughts on software engineering leadership">
  <div class="slate-container py-12">
    <header class="slate-header mb-12">
      <h1 class="slate-title">Blog</h1>
      <p class="slate-subtitle">Thoughts on software engineering leadership and team building</p>
    </header>
    
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p: any) => {
        const post = p as any;
        const href = `/blog/${post.slug}/`;
        return (
          <article class="group relative overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white/50 dark:bg-white/5 shadow-sm hover:shadow-md transition-shadow">
            <div class="p-6">
              <h2 class="text-xl font-semibold tracking-tight">
                <a href={href} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <div class="mt-2 text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2">
                {post.data.author && <span>{post.data.author}</span>}
                <span>•</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              {post.data.description && (
                <p class="mt-3 text-gray-600 dark:text-gray-300 line-clamp-3">{post.data.description}</p>
              )}
              <div class="mt-4 inline-flex items-center text-primary-600 dark:text-primary-400">
                Read more
                <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    
    {posts.length === 0 && (
      <div class="py-8 text-center">
        <p class="text-gray-600 dark:text-gray-400">No blog posts found.</p>
      </div>
    )}
  </div>
</BaseLayout>
