---
import BaseLayout from './BaseLayout.astro';
import { format } from 'date-fns';

// Accept either legacy `frontmatter` (from page MD) or `postData` (from content collections)
type Props = {
  frontmatter?: any;
  postData?: any;
};

const { frontmatter, postData } = Astro.props;
const data = frontmatter ?? postData ?? {};

const formattedDate = data.date 
  ? format(new Date(data.date), 'MMMM d, yyyy')
  : '';
---

<BaseLayout title={`${data.title} | Simon Young`} description={data.description}>
  <article class="slate-container py-10">
    <header class="mb-8">
      <a href="/blog" class="slate-link text-sm font-medium mb-4 inline-block">
        ← Back to Blog
      </a>
      <h1 class="slate-title mb-3">{data.title}</h1>
      <div class="flex items-center text-gray-600 dark:text-gray-400">
        {data.author && <span class="mr-2">{data.author}</span>}
        {formattedDate && (
          <>
            <span class="mx-2">•</span>
            <time datetime={data.date}>{formattedDate}</time>
          </>
        )}
      </div>
    </header>
    
    <div class="prose dark:prose-invert prose-slate lg:prose-lg mx-auto">
      <slot />
    </div>
  </article>
</BaseLayout>